---
interface Props {
  items: Array<{ q: string; a: string }>;
}

const { items } = Astro.props;
---

<div class="border-t border-rule">
  {
    items.map((item, index) => (
      <details class="group border-b border-rule-soft" open={index === 0}>
        <summary class="cursor-pointer py-5 pr-4 text-[0.9375rem] font-semibold marker:text-clay sm:text-[1rem]">
          {item.q}
        </summary>
        <p class="max-w-2xl pb-6 text-[0.9375rem] leading-relaxed text-ink-soft">{item.a}</p>
      </details>
    ))
  }
</div>
