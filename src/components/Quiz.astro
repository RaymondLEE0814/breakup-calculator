---
import type { CalcConfig, FaultConfig } from '../lib/calc/types';

interface Props {
  config: CalcConfig | FaultConfig;
}

const { config } = Astro.props;
const total = config.questions.length;
const isFault = config.type === 'fault';
const eyebrow = isFault ? '법률 정리' : config.depth === 'deep' ? '심화 진단' : '빠른 검사';
---

<div
  id="quiz"
  data-calc={config.type}
  class="mx-auto max-w-3xl px-5 pb-8 sm:px-8"
  aria-live="polite"
>
  {/* Intro. Server-rendered so the first paint needs no JavaScript, and so a
      crawler sees real copy rather than an empty mount point. */}
  <div id="quiz-intro">
    <p class="gutter-label">{eyebrow}</p>
    <h1 class="mt-4 max-w-2xl text-[2.25rem] leading-tight sm:text-[3rem]">{config.title}</h1>
    <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft">{config.intro}</p>

    <form id="quiz-start" class="surface-card mt-10 p-5 sm:p-7">
      <fieldset>
        <legend class="text-[0.9375rem] font-semibold">어느 쪽 입장에서 답하시나요?</legend>
        <p class="mt-1.5 text-[0.8125rem] text-ink-faint">
          선택은 질문에 쓰이는 호칭에만 반영되며, 점수는 어느 쪽을 고르셔도 동일합니다.
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
          {
            [
              { value: 'm', label: '남성입니다' },
              { value: 'f', label: '여성입니다' },
              { value: 'na', label: '밝히지 않을래요' },
            ].map((option, i) => (
              <label class="flex flex-1 cursor-pointer items-center gap-2.5 rounded-xl border border-rule bg-white px-4 py-3 text-[0.9375rem] transition-colors hover:border-clay has-checked:border-clay has-checked:bg-clay-soft">
                <input
                  type="radio"
                  name="perspective"
                  value={option.value}
                  checked={i === 2}
                  class="accent-clay"
                />
                {option.label}
              </label>
            ))
          }
        </div>
      </fieldset>

      <button type="submit" class="button-primary mt-8 w-full sm:w-auto">
        {total}개 질문 시작하기 · {config.minutes}
      </button>
      <p class="mt-4 text-[0.8125rem] text-ink-faint">
        답변은 이 기기 안에서만 처리되며, 저장 버튼을 누르시기 전에는 어디에도 전송되지 않습니다.
      </p>
    </form>

    <noscript>
      <p class="mt-6 rounded-xl border border-rule bg-paper-raised p-4 text-[0.875rem] text-ink-soft">
        이 계산기는 브라우저 안에서 직접 계산합니다. 자바스크립트를 켜시면 바로 이용하실 수 있습니다.
      </p>
    </noscript>
  </div>

  {/* Question stage, filled in by the script below. */}
  <div id="quiz-stage" class="surface-card min-h-[32rem] p-5 sm:p-8" hidden>
    <div class="flex items-center justify-between gap-4 pt-2">
      <p id="quiz-step" class="gutter-label"></p>
      <p id="quiz-count" class="gutter-label nums"></p>
    </div>
    <div class="mt-3 h-1 w-full rounded-full bg-rule-soft" role="presentation">
      <div
        id="quiz-bar"
        class="h-1 rounded-full bg-clay transition-[width] duration-300 ease-out"
        style="width:0%"
      >
      </div>
    </div>

    <h2 id="quiz-question" class="mt-9 text-[1.375rem] leading-snug sm:text-[1.5rem]"></h2>
    <p id="quiz-caption" class="mt-2 text-[0.8125rem] text-ink-faint"></p>

    <div id="quiz-choices" class="mt-7 flex flex-col gap-2" role="radiogroup"></div>

    <div class="mt-8 flex items-center justify-between border-t border-rule-soft pt-5">
      <button
        type="button"
        id="quiz-back"
        class="text-[0.875rem] text-ink-soft transition-colors hover:text-ink"
      >
        ← 이전
      </button>
      <button
        type="button"
        id="quiz-restart"
        class="text-[0.875rem] text-ink-faint transition-colors hover:text-ink"
      >
        처음부터
      </button>
    </div>
  </div>
</div>

<script>
  import { CONFIGS } from '../lib/calc';
  import { fault } from '../lib/calc/fault';
  import { allQuestions, faultSequence, withPronoun } from '../lib/calc/engine';
  import type {
    AnswerMap,
    CalcConfig,
    CalcType,
    Perspective,
    Question,
  } from '../lib/calc/types';
  import { loadSession, saveSession, clearSession } from '../lib/storage';

  const root = document.getElementById('quiz');
  if (root) {
    const type = root.dataset.calc as CalcType | 'fault';
    const isFault = type === 'fault';
    const config = isFault ? fault : CONFIGS[type as CalcType];

    /**
     * The fault calculator asks a follow-up under any item that reported
     * something happened, so its list of screens changes as answers change.
     * Everything below therefore navigates by question id rather than by a
     * fixed index — an index would point at a different question the moment a
     * follow-up appeared or vanished.
     */
    const parentIndex = new Map<string, number>();
    if (isFault) {
      fault.questions.forEach((q, i) => {
        parentIndex.set(q.id, i);
        parentIndex.set(q.direction.id, i);
      });
    }

    const intro = document.getElementById('quiz-intro')!;
    const stage = document.getElementById('quiz-stage')!;
    const stepEl = document.getElementById('quiz-step')!;
    const countEl = document.getElementById('quiz-count')!;
    const barEl = document.getElementById('quiz-bar')!;
    const questionEl = document.getElementById('quiz-question')!;
    const captionEl = document.getElementById('quiz-caption')!;
    const choicesEl = document.getElementById('quiz-choices')!;
    const backBtn = document.getElementById('quiz-back') as HTMLButtonElement;
    const restartBtn = document.getElementById('quiz-restart')!;
    const startForm = document.getElementById('quiz-start') as HTMLFormElement;

    let perspective: Perspective = 'na';
    let answers: AnswerMap = {};
    let currentId = '';
    /** Blocks a second click while the auto-advance animation runs. */
    let locked = false;

    function sequence(): Question[] {
      return isFault ? faultSequence(fault, answers) : allQuestions(config as CalcConfig);
    }

    function positionOf(seq: Question[]): number {
      const i = seq.findIndex((q) => q.id === currentId);
      return i === -1 ? 0 : i;
    }

    function render() {
      const seq = sequence();
      const at = positionOf(seq);
      const q = seq[at];
      currentId = q.id;

      const isSafety = config.safety?.id === q.id;
      const step = config.steps[q.step - 1];

      if (isSafety) {
        stepEl.textContent = '시작하기 전에';
        countEl.textContent = '';
        barEl.style.width = '0%';
        captionEl.textContent = '이 답변은 점수에 들어가지 않고, 저장되지도 않습니다.';
      } else if (isFault) {
        // Count by the parent item, so a follow-up does not read as a new
        // question and the total never jumps around.
        const n = (parentIndex.get(q.id) ?? 0) + 1;
        stepEl.textContent = step ? `${step.title}` : '';
        countEl.textContent = `${n} / ${fault.questions.length}`;
        barEl.style.width = `${(n / fault.questions.length) * 100}%`;
        captionEl.textContent = step?.caption ?? '';
      } else {
        const offset = config.safety ? 1 : 0;
        const n = at - offset + 1;
        stepEl.textContent = step ? `STEP ${q.step} · ${step.title}` : '';
        countEl.textContent = `${n} / ${config.questions.length}`;
        barEl.style.width = `${(n / config.questions.length) * 100}%`;
        captionEl.textContent = step?.caption ?? '';
      }

      questionEl.textContent = withPronoun(q.text, config, perspective);
      backBtn.disabled = at === 0;
      backBtn.classList.toggle('invisible', at === 0);

      choicesEl.innerHTML = '';
      q.choices.forEach((choice, i) => {
        const selected = answers[q.id] === i;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.role = 'radio';
        btn.ariaChecked = String(selected);
        btn.dataset.choice = String(i);
        btn.className = [
          'settle w-full rounded-xl border px-4 py-3.5 text-left text-[0.9375rem] leading-snug transition-colors',
          selected
            ? 'border-clay bg-clay-soft text-ink'
            : 'border-rule bg-white text-ink-soft hover:border-clay hover:text-ink',
        ].join(' ');
        btn.style.animationDelay = `${i * 40}ms`;
        btn.textContent = withPronoun(choice.label, config, perspective);
        btn.addEventListener('click', () => pick(i));
        choicesEl.appendChild(btn);
      });

      // Move focus to the question so a screen reader announces the new screen
      // instead of silently swapping the buttons underneath the cursor.
      questionEl.setAttribute('tabindex', '-1');
      questionEl.focus({ preventScroll: true });
    }

    function pick(choiceIndex: number) {
      if (locked) return;
      answers[currentId] = choiceIndex;
      saveSession(type, { perspective, answers });

      choicesEl.querySelectorAll('button').forEach((b) => {
        const chosen = b.dataset.choice === String(choiceIndex);
        b.ariaChecked = String(chosen);
        b.className = b.className.replace(
          /border-rule bg-white text-ink-soft hover:border-clay hover:text-ink|border-clay bg-clay-soft text-ink/,
          chosen
            ? 'border-clay bg-clay-soft text-ink'
            : 'border-rule bg-white text-ink-soft hover:border-clay hover:text-ink',
        );
      });

      locked = true;
      // A beat long enough to see the choice register, short enough not to feel
      // like waiting.
      window.setTimeout(() => {
        locked = false;
        // Recomputed after the answer, so a follow-up that just became
        // relevant is already in the list.
        const seq = sequence();
        const at = positionOf(seq);
        if (at + 1 < seq.length) {
          currentId = seq[at + 1].id;
          render();
        } else {
          window.location.href = `${config.path}/result`;
        }
      }, 220);
    }

    /** The reference sections below the fold are noise once answering starts. */
    function enterQuiz() {
      intro.hidden = true;
      stage.hidden = false;
      document.getElementById('quiz-aside')?.setAttribute('hidden', '');
    }

    function exitQuiz() {
      stage.hidden = true;
      intro.hidden = false;
      document.getElementById('quiz-aside')?.removeAttribute('hidden');
    }

    startForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const picked = new FormData(startForm).get('perspective');
      perspective = (picked as Perspective) ?? 'na';
      // A fresh start means fresh answers: a half-finished earlier run would
      // otherwise leak into this one.
      answers = {};
      clearSession(type);
      saveSession(type, { perspective, answers });
      currentId = sequence()[0].id;
      enterQuiz();
      render();
    });

    backBtn.addEventListener('click', () => {
      const seq = sequence();
      const at = positionOf(seq);
      if (at === 0) return;
      currentId = seq[at - 1].id;
      render();
    });

    restartBtn.addEventListener('click', () => {
      clearSession(type);
      answers = {};
      currentId = '';
      exitQuiz();
      window.scrollTo({ top: 0 });
    });

    // Coming back from the result page: resume where the visitor left off
    // rather than making them retype thirty answers.
    const saved = loadSession(type);
    if (saved && Object.keys(saved.answers).length > 0) {
      perspective = saved.perspective;
      answers = saved.answers;
      const seq = sequence();
      const firstUnanswered = seq.find((q) => typeof answers[q.id] !== 'number');
      currentId = (firstUnanswered ?? seq[seq.length - 1]).id;
      enterQuiz();
      render();
    }
  }
</script>
