---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  body: string;
  count: string;
  featured?: boolean;
  /** Stagger the load-in without inline style soup at the call site. */
  delay?: string;
}

const { href, eyebrow, title, body, count, featured = false, delay = '0ms' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'settle group relative flex min-h-64 flex-col justify-between overflow-hidden rounded-2xl border border-rule-soft bg-paper-raised p-6 transition-[transform,border-color,background-color] duration-200 hover:-translate-y-0.5 hover:border-clay hover:bg-white active:translate-y-px sm:p-7',
    featured && 'sm:min-h-72 lg:grid lg:grid-cols-[1fr_auto] lg:items-end lg:gap-10',
  ]}
  style={`animation-delay:${delay}`}
>
  <div>
    <div class="flex items-center justify-between gap-4 text-[0.8125rem] font-semibold">
      <span class="text-clay">{eyebrow}</span>
      <span class="nums text-ink-faint">{count}</span>
    </div>
    <h3
      class:list={[
        'mt-7 text-[1.5rem] leading-tight transition-colors group-hover:text-clay',
        featured && 'max-w-xl sm:text-[2rem]',
      ]}
    >
      {title}
    </h3>
    <p class="mt-3 max-w-lg text-[0.9375rem] leading-relaxed text-ink-soft">{body}</p>
  </div>
  <span class="mt-10 text-[0.875rem] font-bold text-ink transition-colors group-hover:text-clay">
    시작하기
  </span>
</a>
