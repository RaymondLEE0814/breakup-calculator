---
interface Props {
  index: string;
  href: string;
  eyebrow: string;
  title: string;
  body: string;
  count: string;
  /** Stagger the load-in without inline style soup at the call site. */
  delay?: string;
}

const { index, href, eyebrow, title, body, count, delay = '0ms' } = Astro.props;
---

<a
  href={href}
  class="settle group relative flex flex-col gap-3 border-t border-rule py-6 transition-colors hover:border-clay sm:py-7"
  style={`animation-delay:${delay}`}
>
  <div class="flex items-baseline gap-3">
    <span class="gutter-label">{index}</span>
    <span class="text-[0.8125rem] text-ink-faint">{eyebrow}</span>
  </div>
  <h3 class="font-serif text-[1.375rem] leading-snug transition-colors group-hover:text-clay">
    {title}
  </h3>
  <p class="max-w-md flex-1 text-[0.9375rem] leading-relaxed text-ink-soft">{body}</p>
  <div class="mt-3 flex items-center gap-2 text-[0.8125rem] text-ink-faint">
    <span class="nums">{count}</span>
    <span aria-hidden="true">·</span>
    <span class="text-clay transition-transform group-hover:translate-x-0.5">시작하기 →</span>
  </div>
</a>
