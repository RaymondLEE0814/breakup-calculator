---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  blurb: string;
}

const { href, eyebrow, title, blurb } = Astro.props;
---

<a href={href} class="group rounded-2xl border border-rule-soft bg-paper-raised p-5 transition-[transform,border-color,background-color] hover:-translate-y-0.5 hover:border-clay hover:bg-white">
  <span class="text-[0.75rem] font-semibold text-clay">{eyebrow}</span>
  <span class="mt-2 text-[1rem] font-semibold transition-colors group-hover:text-clay">{title}</span>
  <span class="text-[0.875rem] text-ink-faint">{blurb}</span>
</a>
