---
import Quiz from './Quiz.astro';
import Faq from './Faq.astro';
import { maxScore } from '../lib/calc/engine';
import type { CalcConfig } from '../lib/calc/types';

interface Props {
  config: CalcConfig;
  faq: Array<{ q: string; a: string }>;
  /** Guide articles that pair with this calculator. */
  reading: Array<{ href: string; title: string; blurb: string }>;
  /** The other depth for this life stage — screener from deep, or the reverse. */
  sibling: CalcConfig;
}

const { config, faq, reading, sibling } = Astro.props;

const byStep = config.steps.map((step, i) => ({
  ...step,
  index: i + 1,
  questions: config.questions.filter((q) => q.step === i + 1),
}));

// Level-only dimensions carry weight 0 and would win a sort by ascending
// accident; only weighted ones can be "the heaviest".
const heaviest = config.dims.filter((d) => d.weight > 0).sort((a, b) => b.weight - a.weight)[0];
const isSimple = config.depth === 'simple';
---

<Quiz config={config} />

{/* Hidden while answering, but present in the HTML: this is the readable,
    crawlable half of the page. */}
<div id="quiz-aside" class="mx-auto max-w-3xl px-5 sm:px-8">
  <section class="mt-20" aria-labelledby="asks">
    <h2 id="asks" class="text-[1.75rem]">이 계산기가 묻는 것</h2>
    <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-faint">
      가중치가 가장 큰 축은 <strong class="text-ink-soft">{heaviest.label}</strong>({Math.round(
        heaviest.weight * 100,
      )}%)입니다. 문항 옆 숫자는 그 문항에서 붙을 수 있는 최대 점수입니다.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        byStep.map((step) => (
          <div class="surface-card p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-[1.0625rem]">{step.title}</h3>
              <span class="shrink-0 text-[0.75rem] text-ink-faint nums">
                {step.questions.length}개 문항
              </span>
            </div>
            <ul class="mt-4 flex flex-col gap-2.5">
              {step.questions.map((q) => (
                <li class="flex items-baseline justify-between gap-4 text-[0.9375rem] text-ink-soft">
                  <span>{q.text.replace(/\{(?:상대|배우자)\}/g, config.pronoun.na)}</span>
                  <span class="sr-only">최대 {maxScore(q)}점</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-[0.875rem] leading-relaxed text-ink-soft">
      선택지별 배점과 축 가중치, 지수를 만드는 계산식은 <a
        href="/about"
        class="text-clay underline underline-offset-[3px]">계산 방식 페이지</a
      >에 모두 공개되어 있습니다.
    </p>
  </section>

  <section class="mt-20 border-t border-rule pt-10" aria-labelledby="sibling">
    <h2 id="sibling" class="text-[1.75rem]">
      {isSimple ? '시간이 있다면, 심화 검사부터' : '먼저 1분짜리로 가볍게'}
    </h2>
    <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft">
      {
        isSimple
          ? '두 검사는 길이만 다른 것이 아니라 다른 도구입니다. 이 검사는 빠르게 걸러 내는 선별 검사이고, 심화 검사는 관계를 구조로 나눠 보는 진단 검사입니다. 두 결과가 다르게 나올 수 있으며, 그럴 때는 심화 검사 쪽이 더 많은 정보를 담고 있습니다.'
          : '지금 긴 검사를 할 여유가 없으시다면, 같은 관계를 일곱 문항으로 빠르게 훑어볼 수 있습니다. 숫자 하나와 한 줄 진단만 나오지만, 시작점으로는 충분합니다.'
      }
    </p>
    <a href={sibling.path} class="button-secondary mt-6"
      >{sibling.name} · {sibling.questions.length}문항 {sibling.minutes}</a
    >
  </section>

  <section class="mt-20 border-t border-rule pt-10" aria-labelledby="calc-faq">
    <h2 id="calc-faq" class="text-[1.75rem]">자주 묻는 질문</h2>
    <Faq items={faq} />
  </section>

  <section class="mt-20 border-t border-rule pt-10" aria-labelledby="reading">
    <h2 id="reading" class="text-[1.75rem]">함께 읽어보기</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        reading.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col rounded-2xl border border-rule-soft bg-paper-raised p-5 transition-[transform,border-color,background-color] hover:-translate-y-0.5 hover:border-clay hover:bg-white"
          >
            <span class="text-[0.9375rem] font-semibold transition-colors group-hover:text-clay">
              {item.title}
            </span>
            <span class="mt-1 text-[0.875rem] leading-relaxed text-ink-faint">{item.blurb}</span>
          </a>
        ))
      }
    </div>
  </section>
</div>
