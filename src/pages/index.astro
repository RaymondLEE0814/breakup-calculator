---
import Base from '../layouts/Base.astro';
import CalcCard from '../components/CalcCard.astro';
import { FAMILIES, FAMILY_LABEL, pair } from '../lib/calc';
import type { Family } from '../lib/calc/types';
import Faq from '../components/Faq.astro';
import { SITE } from '../lib/site';
import { breadcrumbLd, faqLd, webAppLd, websiteLd } from '../lib/site';

const title = '이혼 확률 계산기 | 연애·부부·황혼 관계 위험 자가진단';

/** One line per card. Kept here rather than in the config: this is marketing
 *  copy for a landing page, not part of the measurement model. */
const FAMILY_BLURB: Record<Family, { simple: string; deep: string }> = {
  breakup: {
    simple: '요즘 자주 다투거나, 마음이 예전 같지 않다면. 일곱 문항으로 빠르게 훑어봅니다.',
    deep: '만족, 대안, 투자, 헌신, 갈등, 애착, 압력. 일곱 개 구조로 나눠 봅니다.',
  },
  divorce: {
    simple: '말수가 줄고 같은 문제로 반복해서 부딪히고 있다면. 일곱 문항이면 됩니다.',
    deep: '무엇이 이 결혼을 붙잡고 있는지 — 마음인지 조건인지 — 를 따로 재어 봅니다.',
  },
  twilight: {
    simple: '은퇴 이후, 하루 종일 마주하게 된 두 사람이라면. 일곱 문항으로 시작합니다.',
    deep: '헌신과 제약을 나눠 재고, 은퇴·돌봄·노후자금의 압력을 함께 봅니다.',
  },
};

const faq = [
  {
    q: '이 결과는 진짜 확률인가요?',
    a: '아닙니다. 통계적으로 산출한 예측 확률이 아니라, 관계 연구에서 위험 신호로 알려진 항목들을 점수화해 만든 위험 지수입니다. 같은 지수라도 두 사람의 선택에 따라 얼마든지 달라집니다.',
  },
  {
    q: '무엇을 근거로 점수를 매기나요?',
    a: '갈등 상황의 대화 방식, 화해 시도가 받아들여지는지 여부, 애정 표현과 대화의 빈도 같은 관계 행동 변수에 가장 큰 가중치를 둡니다. 나이 차이나 경제 상황은 보조 변수로만 반영합니다. 항목과 배점은 계산 방식 페이지에 모두 공개되어 있습니다.',
  },
  {
    q: '소득이나 키 같은 스펙을 입력해야 하나요?',
    a: '입력하지 않습니다. 이 계산기는 사람을 조건으로 줄 세우지 않습니다. 액수나 수치 대신 "그 문제로 갈등한 적이 있는지", "서로의 기대와 현실 사이에 간극이 있는지"만 묻습니다.',
  },
  {
    q: '답변한 내용이 저장되나요?',
    a: '아니요. 모든 계산은 접속하신 기기 안에서 이루어지며, 응답은 서버로 전송되지 않습니다. 결과 공유하기를 직접 누르셨을 때에만 지수와 등급 같은 요약 정보가 익명으로 저장됩니다.',
  },
  {
    q: '회원가입이 필요한가요?',
    a: '필요 없습니다. 무료이며, 이름이나 이메일을 포함한 어떤 개인정보도 요구하지 않습니다.',
  },
];

const schemas = [
  websiteLd(),
  webAppLd({ name: SITE.name, path: '/', description: SITE.description }),
  faqLd(faq),
  breadcrumbLd([{ name: '홈', path: '/' }]),
];
---

<Base title={title} description={SITE.description} path="/" schemas={schemas}>
  <section
    class="mx-auto grid min-h-[calc(100dvh-106px)] max-w-7xl items-center gap-10 px-5 py-10 sm:min-h-[calc(100dvh-69px)] sm:px-8 sm:py-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-14 lg:px-10"
  >
    <div class="relative z-10 py-2 lg:py-8">
      <p class="gutter-label settle">RELATIONSHIP CHECK</p>
      <h1 class="settle mt-5 max-w-xl text-display" style="animation-delay:60ms">
        이혼 확률 계산기
      </h1>
      <p
        class="settle mt-6 max-w-lg text-[1.0625rem] leading-relaxed text-ink-soft sm:text-[1.125rem]"
        style="animation-delay:120ms"
      >
        연애부터 부부, 황혼까지. 관계 연구에 기반한 질문으로 지금 두 사람 사이의 위험 신호를
        짚어봅니다.
      </p>
      <div class="settle mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:180ms">
        <a href="#calculators" class="button-primary">진단 고르기</a>
        <a href="/about" class="button-secondary">계산 방식</a>
      </div>
    </div>

    <figure class="settle overflow-hidden rounded-2xl bg-paper-raised" style="animation-delay:120ms">
      <picture>
        <source srcset="/images/relationship-distance-hero.webp" type="image/webp" />
        <img
          src="/images/relationship-distance-hero.jpg"
          width="1536"
          height="1024"
          alt="서로 마주 보며 작은 간격을 둔 두 개의 검정 형태와 파란 면"
          class="aspect-[3/2] h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </section>

  <section class="border-y border-rule-soft" aria-label="서비스 특징">
    <div class="mx-auto grid max-w-7xl grid-cols-1 px-5 sm:grid-cols-3 sm:px-8 lg:px-10">
      <div class="py-5 sm:border-r sm:border-rule-soft sm:pr-7">
        <p class="text-[0.8125rem] text-ink-faint">비용</p>
        <p class="mt-1 font-semibold">완전 무료</p>
      </div>
      <div class="border-t border-rule-soft py-5 sm:border-t-0 sm:border-r sm:px-7">
        <p class="text-[0.8125rem] text-ink-faint">소요 시간</p>
        <p class="mt-1 font-semibold">약 3분</p>
      </div>
      <div class="border-t border-rule-soft py-5 sm:border-t-0 sm:pl-7">
        <p class="text-[0.8125rem] text-ink-faint">응답 처리</p>
        <p class="mt-1 font-semibold">내 기기 안에서만</p>
      </div>
    </div>
  </section>

  <section
    id="calculators"
    class="mx-auto max-w-7xl px-5 pt-24 sm:px-8 sm:pt-32 lg:px-10"
    aria-labelledby="calculators-title"
  >
    <div class="max-w-2xl">
      <h2 id="calculators-title" class="text-[2rem] sm:text-[2.75rem]">지금 두 사람에게 맞는 질문</h2>
      <p class="mt-4 max-w-xl text-[1rem] leading-relaxed text-ink-soft">
        관계의 시기마다 물어야 할 것이 다릅니다. 그리고 시기마다 두 가지 길이가 있습니다 — 1분짜리
        빠른 선별 검사와, 관계를 구조로 나눠 보는 심화 진단입니다. 둘은 길이만 다른 것이 아니라 다른
        도구입니다.
      </p>
    </div>

    {
      FAMILIES.map((family, i) => {
        const { simple, deep } = pair(family);
        return (
          <div class="mt-10">
            <p class="gutter-label">{FAMILY_LABEL[family]}</p>
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
              <CalcCard
                href={simple.path}
                eyebrow="빠른 검사"
                title={simple.name}
                body={FAMILY_BLURB[family].simple}
                count={`${simple.questions.length}문항 · ${simple.minutes}`}
                delay={`${i * 60}ms`}
              />
              <CalcCard
                href={deep.path}
                eyebrow="심화 진단"
                title={deep.name}
                body={FAMILY_BLURB[family].deep}
                count={`${deep.questions.length}문항 · ${deep.minutes}`}
                delay={`${i * 60 + 30}ms`}
              />
            </div>
          </div>
        );
      })
    }
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-5 pt-24 sm:px-8 sm:pt-32 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-20 lg:px-10" aria-labelledby="how">
    <picture class="overflow-hidden rounded-2xl bg-paper-raised">
      <source srcset="/images/conversation-gap.webp" type="image/webp" />
      <img
        src="/images/conversation-gap.jpg"
        width="1200"
        height="1200"
        alt="검정 형태 두 개 사이에 놓인 짧은 파란 선"
        class="aspect-square h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div>
      <h2 id="how" class="text-[2rem] sm:text-[2.75rem]">조건보다, 다루는 방식을 봅니다</h2>
      <p class="mt-5 max-w-xl text-[1rem] leading-relaxed text-ink-soft">
        이별과 이혼을 실제로 예측하는 것은 조건이 아니라 대화입니다. 비난, 경멸, 방어, 담쌓기 같은
        반복되는 대화 습관에 가장 큰 가중치를 둡니다.
      </p>
      <div class="mt-8 border-t border-rule">
        <div class="grid gap-2 border-b border-rule-soft py-5 sm:grid-cols-[9rem_1fr]">
          <h3 class="text-[1rem]">대화와 갈등</h3>
          <p class="text-[0.9375rem] text-ink-soft">다툴 때의 말투, 침묵의 길이, 화해가 받아들여지는지</p>
        </div>
        <div class="grid gap-2 border-b border-rule-soft py-5 sm:grid-cols-[9rem_1fr]">
          <h3 class="text-[1rem]">관계와 현실</h3>
          <p class="text-[0.9375rem] text-ink-soft">함께한 시간, 거리, 자녀, 양가, 돈을 다루는 방식</p>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[9rem_1fr]">
          <h3 class="text-[1rem]">마음과 전망</h3>
          <p class="text-[0.9375rem] text-ink-soft">대화량과 애정 표현, 이 관계의 미래를 보는 시선</p>
        </div>
      </div>
      <a href="/about" class="button-secondary mt-7">계산 방식 확인</a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pt-24 sm:px-8 sm:pt-32" aria-labelledby="faq">
    <h2 id="faq" class="text-[2rem] sm:text-[2.75rem]">자주 묻는 질문</h2>
    <p class="mt-4 max-w-xl text-[1rem] leading-relaxed text-ink-soft">
      계산하기 전에 가장 많이 궁금해하시는 내용을 모았습니다.
    </p>
    <div class="mt-10">
      <Faq items={faq} />
    </div>
  </section>
</Base>
