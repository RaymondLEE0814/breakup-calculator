---
import Base from '../layouts/Base.astro';
import CalcCard from '../components/CalcCard.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../lib/site';
import { breadcrumbLd, faqLd, webAppLd, websiteLd } from '../lib/site';

const title = '헤어질 확률 계산기 — 연인·부부·황혼 관계 위험 자가진단';

const faq = [
  {
    q: '이 결과는 진짜 확률인가요?',
    a: '아닙니다. 통계적으로 산출한 예측 확률이 아니라, 관계 연구에서 위험 신호로 알려진 항목들을 점수화해 만든 위험 지수입니다. 같은 지수라도 두 사람의 선택에 따라 얼마든지 달라집니다.',
  },
  {
    q: '무엇을 근거로 점수를 매기나요?',
    a: '갈등 상황의 대화 방식, 화해 시도가 받아들여지는지 여부, 애정 표현과 대화의 빈도 같은 관계 행동 변수에 가장 큰 가중치를 둡니다. 나이 차이나 경제 상황은 보조 변수로만 반영합니다. 항목과 배점은 계산 방식 페이지에 모두 공개되어 있습니다.',
  },
  {
    q: '소득이나 키 같은 스펙을 입력해야 하나요?',
    a: '입력하지 않습니다. 이 계산기는 사람을 조건으로 줄 세우지 않습니다. 액수나 수치 대신 "그 문제로 갈등한 적이 있는지", "서로의 기대와 현실 사이에 간극이 있는지"만 묻습니다.',
  },
  {
    q: '답변한 내용이 저장되나요?',
    a: '아니요. 모든 계산은 접속하신 기기 안에서 이루어지며, 응답은 서버로 전송되지 않습니다. 결과 공유하기를 직접 누르셨을 때에만 지수와 등급 같은 요약 정보가 익명으로 저장됩니다.',
  },
  {
    q: '회원가입이 필요한가요?',
    a: '필요 없습니다. 무료이며, 이름이나 이메일을 포함한 어떤 개인정보도 요구하지 않습니다.',
  },
];

const schemas = [
  websiteLd(),
  webAppLd({ name: SITE.name, path: '/', description: SITE.description }),
  faqLd(faq),
  breadcrumbLd([{ name: '홈', path: '/' }]),
];
---

<Base title={title} description={SITE.description} path="/" schemas={schemas}>
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-14 sm:px-8 sm:pt-24 sm:pb-20">
    <p class="gutter-label settle">RELATIONSHIP RISK INDEX</p>
    <h1
      class="settle mt-5 max-w-2xl text-[2.5rem] leading-[1.18] sm:text-display"
      style="animation-delay:60ms"
    >
      우리, 괜찮은 걸까요?
    </h1>
    <p
      class="settle mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-ink-soft"
      style="animation-delay:120ms"
    >
      연인, 부부, 그리고 은퇴 이후의 두 사람까지. 관계 연구에 기반한 질문으로 지금 우리 사이의 위험
      신호를 담담하게 짚어봅니다. 회원가입 없이, 3분이면 충분합니다.
    </p>
    <p
      class="settle mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] text-ink-faint"
      style="animation-delay:180ms"
    >
      <span>무료</span><span aria-hidden="true">·</span>
      <span>회원가입 없음</span><span aria-hidden="true">·</span>
      <span>응답은 기기 밖으로 나가지 않습니다</span>
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 sm:px-8" aria-labelledby="calculators">
    <h2 id="calculators" class="sr-only">계산기 선택</h2>
    <div class="grid gap-0 sm:grid-cols-3 sm:gap-x-10">
      <CalcCard
        index="01"
        href="/breakup"
        eyebrow="연인"
        title="헤어질 확률 계산기"
        body="요즘 자주 다투거나, 마음이 예전 같지 않다면."
        count="16문항 · 약 3분"
        delay="220ms"
      />
      <CalcCard
        index="02"
        href="/divorce"
        eyebrow="부부"
        title="이혼 확률 계산기"
        body="말수가 줄고, 같은 문제로 반복해서 부딪히고 있다면."
        count="18문항 · 약 4분"
        delay="280ms"
      />
      <CalcCard
        index="03"
        href="/twilight"
        eyebrow="황혼"
        title="황혼 이혼 계산기"
        body="은퇴 이후, 하루 종일 마주하게 된 두 사람이라면."
        count="15문항 · 약 3분"
        delay="340ms"
      />
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-5xl px-5 sm:px-8" aria-labelledby="how">
    <div class="grid gap-10 border-t border-rule pt-10 sm:grid-cols-[9rem_1fr] sm:gap-16">
      <p class="gutter-label">무엇을 보는가</p>
      <div class="prose-quiet">
        <h2 id="how" class="!mt-0 font-serif text-2xl">
          조건이 아니라, 두 사람이 다루는 방식을 봅니다
        </h2>
        <p>
          이별과 이혼을 실제로 예측하는 것은 조건이 아니라 대화입니다. 관계 연구가 반복해서 지목해 온
          위험 신호는 <strong>비난, 경멸, 방어, 담쌓기</strong> 네 가지 대화 습관이었습니다. 이
          계산기가 가장 큰 가중치를 두는 부분도 그곳입니다.
        </p>
        <p>
          그렇다고 현실을 빼놓지는 않습니다. 돈, 집, 양가, 은퇴는 두 사람의 관계에 실제로 얹히는
          무게입니다. 다만 이 계산기는 <strong>액수를 묻지 않습니다.</strong> 얼마를 버는지가 아니라
          그 문제로 다툰 적이 있는지를, 조건이 어떤지가 아니라 그 차이가 두 사람 사이에서 말로 나온 적이
          있는지를 묻습니다. 사람을 조건으로 줄 세우는 계산기는 만들지 않았습니다.
        </p>
        <ul>
          <li><strong>대화와 갈등</strong> — 다툴 때의 말투, 침묵의 길이, 화해가 받아들여지는지</li>
          <li><strong>관계의 조건</strong> — 함께한 시간, 거리, 자녀, 양가, 미래의 방향</li>
          <li><strong>현실과 경제</strong> — 돈을 다루는 방식과 기대의 간극</li>
          <li><strong>마음과 전망</strong> — 대화량, 그리고 이 관계를 어떻게 보고 있는지</li>
        </ul>
        <p>
          문항과 배점은 숨기지 않습니다. <a href="/about">계산 방식 페이지</a>에서 모든 항목의 점수와
          가중치를 그대로 확인하실 수 있습니다.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-5xl px-5 sm:px-8" aria-labelledby="faq">
    <div class="grid gap-10 border-t border-rule pt-10 sm:grid-cols-[9rem_1fr] sm:gap-16">
      <p class="gutter-label">자주 묻는 것</p>
      <div>
        <h2 id="faq" class="font-serif text-2xl">자주 묻는 질문</h2>
        <Faq items={faq} />
      </div>
    </div>
  </section>
</Base>
