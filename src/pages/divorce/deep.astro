---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { divorce, divorceDeep } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '부부 관계 심화 진단 | 34문항 부부 갈등 테스트';
const description =
  '34개 문항으로 지금의 결혼을 여덟 개 구조로 나눠 봅니다. 만족, 갈등 대처, 헌신과 제약, 대안, 돈·자녀·양가의 압력, 지속 취약성, 이혼을 향한 걸음. 무료 심화 진단.';

const faq = [
  {
    q: '빠른 검사와 무엇이 다른가요?',
    a: '다른 도구입니다. 일곱 문항짜리는 선별 검사이고, 이 검사는 구조를 나눠 보는 진단 검사입니다. 두 결과가 다를 수 있으며, 그럴 때는 이쪽이 더 많은 정보를 담고 있습니다.',
  },
  {
    q: '"제약 수준"은 왜 지수에 직접 반영되지 않나요?',
    a: '제약이 높다는 것 자체는 위험이 아니기 때문입니다. 헌신이 높은 부부에게 자녀나 경제 같은 조건은 그저 안정된 삶의 조건입니다. 문제가 되는 것은 남고 싶은 마음이 사라졌는데 떠나기 어려운 조건만 남았을 때이고, 이 검사는 그 격차를 따로 계산해 반영합니다.',
  },
  {
    q: '돈이나 자녀 문제는 어떻게 반영되나요?',
    a: '단순히 더해지지 않고, 갈등 대처 방식과 곱해집니다. 같은 스트레스도 대화가 되는 부부는 넘기고 그렇지 않은 부부는 무너지기 때문입니다. 결과 화면에서 "압력 × 대처" 항으로 따로 보여드립니다.',
  },
  {
    q: '유형 분류는 어떻게 정해지나요?',
    a: '상호작용과 헌신 두 축을 각각 50을 기준으로 나눠 네 가지(한 팀형·룸메이트형·과열형·소진형) 중 하나로 분류합니다. 같은 지수라도 유형이 다르면 필요한 대응이 다릅니다.',
  },
  {
    q: '답변이 저장되나요?',
    a: '저장되지 않습니다. 계산은 기기 안에서만 이루어지며, 시작 전 안전 확인 문항의 답변은 어떤 경우에도 저장되거나 공유되지 않습니다.',
  },
];

const reading = [
  {
    href: '/guide/four-horsemen',
    title: '이혼을 예측하는 4가지 대화 습관',
    blurb: '이 검사의 적응 과정 축이 재는 것들입니다.',
  },
  {
    href: '/guide/divorce-reasons-korea',
    title: '한국 부부는 왜 이혼할까',
    blurb: '통계로 보는 이혼 사유와, 통계가 말해주지 않는 것.',
  },
];

const schemas = [
  webAppLd({ name: divorceDeep.name, path: '/divorce/deep', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '이혼 확률 계산기', path: '/divorce' },
    { name: '부부 관계 심화 진단', path: '/divorce/deep' },
  ]),
];
---

<Base
  title={title}
  description={description}
  path="/divorce/deep"
  og="/og/divorce.png"
  schemas={schemas}
>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={divorceDeep} faq={faq} reading={reading} sibling={divorce} />
  </div>
</Base>
