---
import Base from '../../../layouts/Base.astro';
import Result from '../../../components/Result.astro';
import NextLink from '../../../components/NextLink.astro';
import { divorceDeep } from '../../../lib/calc';
---

<Base
  title="부부 관계 심화 진단 결과"
  description="답변을 바탕으로 계산한 관계 위험 지수와 구조별 프로파일입니다."
  path="/divorce/deep/result"
  noindex
>
  <Result branch config={divorceDeep}>
    <Fragment slot="next">
      <NextLink
        href="/guide/four-horsemen"
        eyebrow="가이드"
        title="이혼을 예측하는 4가지 대화 습관"
        blurb="적응 과정 축이 재는 것들입니다."
      />
      <NextLink
        href="/guide/divorce-reasons-korea"
        eyebrow="가이드"
        title="한국 부부는 왜 이혼할까"
        blurb="통계가 말해주는 것과 말해주지 않는 것."
      />
      <NextLink
        href="/twilight/deep"
        eyebrow="다른 진단"
        title="황혼 부부 심화 진단"
        blurb="은퇴와 자녀 독립이 가까우시다면."
      />
    </Fragment>
  </Result>
</Base>
