---
import Base from '../../../layouts/Base.astro';
import Result from '../../../components/Result.astro';
import NextLink from '../../../components/NextLink.astro';
import { divorce, divorceDeep } from '../../../lib/calc';
---

<Base
  title="이혼 확률 계산기 결과"
  description="답변을 바탕으로 계산한 관계 위험 지수와, 지수를 끌어올린 요인들입니다."
  path="/divorce/quick/result"
  noindex
>
  <Result
    branch
    config={divorce}
    deepPath={divorceDeep.path}
    deepName={divorceDeep.name}
    deepMinutes={divorceDeep.minutes}
  >
    <Fragment slot="next">
      <NextLink
        href="/guide/four-horsemen"
        eyebrow="가이드"
        title="이혼을 예측하는 4가지 대화 습관"
        blurb="이 검사가 가장 크게 반영한 항목들입니다."
      />
      <NextLink
        href="/twilight"
        eyebrow="다른 계산기"
        title="황혼 이혼 계산기"
        blurb="결혼 20년이 넘었거나 은퇴를 앞두고 계시다면 그 시기만의 문항이 따로 있습니다."
      />
    </Fragment>
  </Result>
</Base>
