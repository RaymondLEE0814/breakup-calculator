---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { divorce, divorceDeep } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '이혼 확률 계산기 | 1분 만에 보는 부부 위험 신호';
const description =
  '일곱 개의 질문으로 지금 결혼 생활의 위험 신호를 빠르게 확인합니다. 결혼 만족도, 경멸과 회피, 헌신, 그리고 이혼을 향해 실제로 움직인 거리를 묻습니다. 무료, 회원가입 없음, 1분.';

const faq = [
  {
    q: '일곱 문항짜리 이혼 확률 계산기를 믿어도 되나요?',
    a: '이것은 확률이 아니라 선별 검사입니다. 그래서 결과에 ±7의 폭을 함께 표시합니다. 다만 일곱 문항 중 셋은 결혼 만족도 표준 척도의 구조를, 둘은 관계 연구에서 예측력이 가장 잘 알려진 상호작용 패턴을 가져온 것이라 짧은 것치고는 정보 밀도가 높습니다.',
  },
  {
    q: '가장 크게 반영되는 항목은 무엇인가요?',
    a: '결혼 만족이 35%, 오가는 말이 30%입니다. 특히 서로를 깎아내리는 말투와, 한 사람이 문제를 꺼내면 다른 한 사람이 물러나는 패턴 두 가지를 봅니다. 이 두 가지는 부부 관계 연구에서 반복해서 지목되어 온 신호입니다.',
  },
  {
    q: '소득이나 재산을 왜 묻지 않나요?',
    a: '액수는 관계를 설명하지 못하기 때문입니다. 같은 소득이라도 다루는 방식에 따라 부부는 흔들리기도 하고 멀쩡하기도 합니다. 심화 검사에서는 액수 대신 "돈 문제가 생기면 두 사람이 어떻게 하는지"를 묻습니다.',
  },
  {
    q: '이혼 이야기를 꺼낸 적이 있으면 어떻게 되나요?',
    a: '지수에 하한이 걸립니다. 이혼을 입 밖에 낸 단계와 별거·절차를 알아본 단계는 각각 다른 하한을 가집니다. 헤어짐을 향해 실제로 움직인 거리는 마음의 온도보다 앞날을 잘 예고하기 때문입니다.',
  },
  {
    q: '더 자세히 보려면?',
    a: '34문항의 부부 관계 심화 진단은 같은 결혼을 여덟 개의 구조로 나눠 보여드립니다. 특히 이 결혼을 붙잡고 있는 것이 마음인지 조건인지를 따로 재고, 그 둘의 격차를 계산에 반영합니다.',
  },
];

const reading = [
  {
    href: '/guide/four-horsemen',
    title: '이혼을 예측하는 4가지 대화 습관',
    blurb: '비난, 경멸, 방어, 담쌓기 — 관계 연구가 지목한 네 가지.',
  },
  {
    href: '/guide/divorce-reasons-korea',
    title: '한국 부부는 왜 이혼할까',
    blurb: '통계로 보는 이혼 사유와, 통계가 말해주지 않는 것.',
  },
];

const schemas = [
  webAppLd({ name: divorce.name, path: '/divorce', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '이혼 확률 계산기', path: '/divorce' },
  ]),
];
---

<Base
  title={title}
  description={description}
  path="/divorce"
  og="/og/divorce.png"
  schemas={schemas}
>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={divorce} faq={faq} reading={reading} sibling={divorceDeep} />
  </div>
</Base>
