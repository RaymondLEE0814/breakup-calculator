---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextLink from '../../components/NextLink.astro';
import { CONFIGS } from '../../lib/calc';
import { articleLd, breadcrumbLd } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('guide');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles },
  }));
}

const { article, all } = Astro.props;
const { Content } = await render(article);

const path = `/guide/${article.id}`;
const calc = CONFIGS[article.data.calc];
const related = article.data.related
  .map((id: string) => all.find((a) => a.id === id))
  .filter((a): a is (typeof all)[number] => Boolean(a));

const schemas = [
  articleLd({
    headline: article.data.title,
    description: article.data.description,
    path,
    published: article.data.published,
    updated: article.data.updated,
  }),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '가이드', path: '/guide' },
    { name: article.data.title, path },
  ]),
];
---

<Base
  title={`${article.data.title} | 이혼 확률 계산기`}
  description={article.data.description}
  path={path}
  schemas={schemas}
>
  <article class="mx-auto max-w-3xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p class="gutter-label">
      <a href="/guide" class="hover:text-ink">GUIDE</a>
      <span aria-hidden="true"> · </span>
      <time datetime={article.data.published} class="nums">
        {article.data.published.replace(/-/g, '.')}
      </time>
    </p>
    <h1 class="mt-4 text-[2.25rem] leading-[1.2] sm:text-[3rem]">{article.data.title}</h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-soft">{article.data.description}</p>

    <div class="prose-quiet mt-10 border-t border-rule pt-8 text-[1.0625rem]">
      <Content />
    </div>

    <aside class="surface-card mt-14 p-6 sm:p-8">
      <p class="gutter-label">직접 확인해 보기</p>
      <p class="mt-3 text-[1.25rem] font-bold">{calc.title}</p>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">
        {calc.questions.length}개 질문에 답하면 지금 두 사람의 상태를 네 가지 축으로 나눠
        보여드립니다. 무료이고, 답변은 기기 밖으로 나가지 않습니다.
      </p>
      <a
        href={calc.path}
        class="button-primary mt-5"
      >
        내 관계로 확인하기
      </a>
    </aside>

    {
      related.length > 0 && (
        <section class="mt-14 border-t border-rule pt-8">
          <h2 class="text-[1.5rem]">이어지는 글</h2>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {related.map((item) => (
              <NextLink
                href={`/guide/${item.id}`}
                eyebrow="가이드"
                title={item.data.title}
                blurb={item.data.description}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
