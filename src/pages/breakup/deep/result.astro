---
import Base from '../../../layouts/Base.astro';
import Result from '../../../components/Result.astro';
import NextLink from '../../../components/NextLink.astro';
import { breakupDeep } from '../../../lib/calc';
---

<Base
  title="연애 관계 심화 진단 결과"
  description="답변을 바탕으로 계산한 관계 위험 지수와 구조별 프로파일입니다."
  path="/breakup/deep/result"
  noindex
>
  <Result config={breakupDeep}>
    <Fragment slot="next">
      <NextLink
        href="/guide/signs-of-breakup"
        eyebrow="가이드"
        title="헤어지는 커플의 7가지 신호"
        blurb="갈등 과정 축이 무엇을 보는지 정리했습니다."
      />
      <NextLink
        href="/guide/gwontaegi"
        eyebrow="가이드"
        title="권태기, 끝의 신호일까 과정일까"
        blurb="만족은 내려갔는데 헌신은 남아 있다면."
      />
      <NextLink
        href="/divorce/deep"
        eyebrow="다른 진단"
        title="부부 관계 심화 진단"
        blurb="결혼한 두 분이라면 이쪽 문항이 더 잘 맞습니다."
      />
    </Fragment>
  </Result>
</Base>
