---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { breakup } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '연애 헤어질 확률 계산기 | 연인을 위한 관계 위험 자가진단';
const description =
  '요즘 자주 다투거나 마음이 예전 같지 않다면. 16개 질문으로 두 사람의 대화 방식, 조건, 현실, 전망을 짚어 이별 위험 신호를 담담하게 정리해 드립니다. 무료, 회원가입 없음.';

const faq = [
  {
    q: '연애 헤어질 확률 계산기, 얼마나 정확한가요?',
    a: '미래를 맞히는 도구가 아닙니다. 관계 연구가 위험 신호로 반복해서 지목해 온 항목들에 답한 결과를 지수로 정리해 보여줄 뿐입니다. 같은 지수를 받은 두 커플의 결말은 얼마든지 다를 수 있습니다.',
  },
  {
    q: '어떤 항목이 점수에 가장 크게 반영되나요?',
    a: '다툴 때의 대화 방식입니다. 특히 비웃음이나 비꼬는 말이 오가는지, 갈등 뒤 침묵이 얼마나 길어지는지, 먼저 건넨 화해가 받아들여지는지가 가장 높은 배점을 가집니다. 전체 지수의 절반이 이 축에서 나옵니다.',
  },
  {
    q: '나이 차이나 소득 차이가 크면 점수가 나쁘게 나오나요?',
    a: '차이 자체로는 큰 점수가 붙지 않습니다. 이 계산기는 액수나 조건을 묻지 않고, 그 차이가 두 사람 사이에서 실제로 말로 나온 적이 있는지, 그 문제로 다툰 적이 있는지만 묻습니다.',
  },
  {
    q: '장거리 연애라 결과가 걱정됩니다.',
    a: '만나는 빈도는 반영되지만, 관계 조건 축 전체가 최종 지수의 20%이고 그중 일부입니다. 장거리라도 대화와 갈등 해결이 건강하면 지수는 낮게 나옵니다.',
  },
  {
    q: '답변이 저장되나요?',
    a: '저장되지 않습니다. 계산은 접속하신 기기 안에서만 이루어지고, 결과 링크 만들기를 직접 누르셨을 때에만 지수와 축 요약이 익명으로 기록됩니다.',
  },
];

const reading = [
  {
    href: '/guide/signs-of-breakup',
    title: '헤어지는 커플의 7가지 신호',
    blurb: '관계 연구가 말하는 위험 징후를 순서대로 정리했습니다.',
  },
  {
    href: '/guide/gwontaegi',
    title: '권태기, 끝의 신호일까 과정일까',
    blurb: '구분하는 법과, 지나가는 시기로 만드는 방법.',
  },
];

const schemas = [
  webAppLd({ name: breakup.name, path: '/breakup', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '연애 헤어질 확률 계산기', path: '/breakup' },
  ]),
];
---

<Base title={title} description={description} path="/breakup" og="/og/breakup.png" schemas={schemas}>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={breakup} faq={faq} reading={reading} />
  </div>
</Base>
