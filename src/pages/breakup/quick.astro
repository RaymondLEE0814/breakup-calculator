---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { breakup, breakupDeep } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '헤어질 확률 계산기 | 1분 만에 보는 연애 위험 신호';
const description =
  '일곱 개의 질문으로 지금 연애의 위험 신호를 빠르게 확인합니다. 만족도, 대안의 매력, 경멸과 회피 같은 관계 연구의 핵심 변수만 골라 물어봅니다. 무료, 회원가입 없음, 1분.';

const faq = [
  {
    q: '일곱 문항으로 헤어질 확률을 알 수 있나요?',
    a: '확률을 알려드리는 것이 아니라, 위험 신호를 빠르게 걸러내는 선별 검사입니다. 그래서 결과에 ±7의 폭을 함께 표시합니다. 일곱 문항이 감당할 수 있는 정직한 정밀도가 그 정도이기 때문입니다. 더 자세히 보시려면 33문항의 심화 검사를 이용하세요.',
  },
  {
    q: '왜 나이나 소득, 사귄 기간을 묻지 않나요?',
    a: '개별 커플 수준에서 예측력이 거의 없으면서, 사람을 조건으로 줄 세우는 인상만 남기기 때문입니다. 대신 관계 연구가 실제로 예측에 쓰는 변수 — 만족도, 헤어진 뒤가 얼마나 선명하게 그려지는지, 다툴 때 어떤 말이 오가는지 — 를 묻습니다.',
  },
  {
    q: '가장 크게 반영되는 항목은 무엇인가요?',
    a: '관계 전반의 만족이 35%로 가장 큽니다. 그다음이 헌신과 대안(30%)입니다. 헤어진 뒤의 생활이 구체적으로 그려질수록 관계를 붙잡는 힘이 약해진다는 것은, 관계 연구에서 대안의 매력이라 부르는 잘 알려진 항목입니다.',
  },
  {
    q: '이별을 이야기한 적이 있으면 결과가 크게 달라지나요?',
    a: '네. 이별을 실제로 꺼낸 적이 있다는 응답은 다른 응답이 온화하더라도 지수에 하한을 겁니다. 헤어짐을 향해 실제로 움직인 거리는 마음의 온도보다 앞날을 잘 예고하기 때문입니다.',
  },
  {
    q: '답변이 저장되나요?',
    a: '저장되지 않습니다. 계산은 접속하신 기기 안에서만 이루어지고, 결과 링크 만들기를 직접 누르셨을 때에만 지수와 축 요약이 익명으로 기록됩니다. 결과 화면에서 상담 신청으로 이어 가시는 경우에도, 신청서에는 연락처와 (원하실 때만) 결과 요약이 담길 뿐 문항별 답변은 담기지 않습니다.',
  },
];

const reading = [
  {
    href: '/guide/signs-of-breakup',
    title: '헤어지는 커플의 7가지 신호',
    blurb: '관계 연구가 말하는 위험 징후를 순서대로 정리했습니다.',
  },
  {
    href: '/guide/gwontaegi',
    title: '권태기, 끝의 신호일까 과정일까',
    blurb: '구분하는 법과, 지나가는 시기로 만드는 방법.',
  },
];

const schemas = [
  webAppLd({ name: breakup.name, path: '/breakup', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '헤어질 확률 계산기', path: '/breakup' },
  ]),
];
---

<Base
  title={title}
  description={description}
  path="/breakup/quick"
  og="/og/breakup.png"
  schemas={schemas}
>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={breakup} faq={faq} reading={reading} sibling={breakupDeep} />
  </div>
</Base>
