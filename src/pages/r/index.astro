---
import Base from '../../layouts/Base.astro';

/**
 * One shell for every /r/<slug>. The Worker serves this file for any share
 * path; the script reads the slug from the URL and fetches the stored summary.
 * Answers were never stored, so a recipient sees the shape of the result and
 * nothing that was confessed to the form.
 */
---

<Base
  title="공유된 결과 | 이혼 확률 계산기"
  description="공유된 관계 위험 지수 결과입니다."
  path="/r"
  noindex
>
  <div id="shared" class="mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-16">
    <div id="shared-state" class="surface-card animate-pulse p-6 sm:p-9" role="status">
      <span class="sr-only">공유 결과를 불러오는 중</span>
      <div class="h-3 w-24 rounded bg-rule"></div>
      <div class="mt-7 h-20 w-48 rounded bg-rule-soft"></div>
      <div class="mt-8 h-6 w-3/4 rounded bg-rule-soft"></div>
    </div>

    <article id="shared-body" class="surface-card p-6 sm:p-9" hidden>
      <p class="gutter-label"><span id="shared-kind"></span> · 공유된 결과</p>
      <div class="mt-6 flex items-end gap-5">
        <p class="text-[4.5rem] font-bold leading-none tracking-[-0.07em] nums sm:text-[5.5rem]">
          <span id="shared-index">0</span><span class="text-[0.4em] align-super">%</span>
        </p>
        <p id="shared-badge" class="mb-3 rounded-full border px-3 py-1 text-[0.8125rem] font-semibold">
        </p>
      </div>
      <p class="mt-4 text-[0.8125rem] text-ink-faint">관계 위험 지수</p>

      <h1 id="shared-headline" class="mt-7 text-[1.625rem] leading-snug sm:text-[1.875rem]"></h1>
      <p class="mt-7 rounded-xl bg-clay-soft p-4 text-[0.875rem] leading-relaxed text-ink-soft">
        이 수치는 한 사람이 답한 결과이며, 정해진 미래가 아닙니다. 답변 내용은 저장되지 않아 이
        화면에도 표시되지 않습니다.
      </p>

      <p
        id="shared-legacy"
        class="mt-3 rounded-xl border border-rule p-4 text-[0.875rem] leading-relaxed text-ink-faint"
        hidden
      >
        이 결과는 이전 버전 검사로 측정되었습니다. 현재 검사는 문항과 계산 방식이 다르므로, 지금
        다시 해보시면 숫자가 달라질 수 있습니다.
      </p>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="text-[1.5rem]">구조로 나눠 보면</h2>
        <dl id="shared-axes" class="mt-7 flex flex-col gap-5"></dl>
      </section>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="text-[1.5rem]">당신이 본 두 사람의 관계는 어떤가요?</h2>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
          같은 관계도 보는 자리에 따라 다르게 보입니다. 같은 질문에 직접 답해 보면, 어디에서 서로를
          다르게 느끼고 있었는지가 드러납니다.
        </p>
        <a
          id="shared-cta"
          href="/"
          class="button-primary mt-6"
        >
          나도 해보기
        </a>
      </section>
    </article>

    <div id="shared-missing" class="surface-card p-6 sm:p-9" hidden>
      <h1 class="mt-4 text-[1.75rem] leading-snug">결과를 찾을 수 없습니다</h1>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-soft">
        링크가 잘못되었거나 삭제된 결과일 수 있습니다. 직접 검사해 보시겠어요?
      </p>
      <a
        href="/"
        class="button-primary mt-8"
      >
        계산기 둘러보기
      </a>
    </div>
  </div>
</Base>

<script>
  import { GRADE_COPY } from '../../lib/calc/factors';
  import type { Grade } from '../../lib/calc/types';
  import { fetchShared } from '../../lib/share';
  import { viewFor } from '../../lib/shared-registry';
  import { countUp, renderDims, toneClasses } from '../../lib/result-view';

  const state = document.getElementById('shared-state')!;
  const missing = document.getElementById('shared-missing')!;

  function fail() {
    state.hidden = true;
    missing.hidden = false;
  }

  const slug = window.location.pathname.replace(/^\/r\/?/, '').replace(/\/$/, '');

  if (!slug) {
    fail();
  } else {
    fetchShared(slug)
      .then((row) => {
        if (!row) {
          fail();
          return;
        }

        // A row written by an older build carries its own label set; the
        // registry hands back whichever one applies.
        const view = viewFor(row);
        const grade = GRADE_COPY[row.grade as Grade];
        if (!view || !grade) {
          fail();
          return;
        }

        state.hidden = true;
        document.getElementById('shared-body')!.hidden = false;
        document.getElementById('shared-kind')!.textContent = view.name;
        if (view.legacy) document.getElementById('shared-legacy')!.hidden = false;

        const badge = document.getElementById('shared-badge')!;
        badge.textContent = grade.name;
        badge.className = `mb-3 rounded-full border px-3 py-1 text-[0.8125rem] font-semibold ${toneClasses(grade.tone)}`;
        document.getElementById('shared-headline')!.textContent = grade.headline;

        countUp(document.getElementById('shared-index')!, row.risk_index);
        renderDims(document.getElementById('shared-axes')!, view.dims);

        const cta = document.getElementById('shared-cta') as HTMLAnchorElement;
        cta.href = view.path;
        cta.textContent = `${view.name} 해보기`;
      })
      .catch(fail);
  }
</script>
