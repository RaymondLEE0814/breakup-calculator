---
import Base from '../../layouts/Base.astro';

/**
 * One shell for every /r/<slug>. The Worker serves this file for any share
 * path; the script reads the slug from the URL and fetches the stored summary.
 * Answers were never stored, so a recipient sees the shape of the result and
 * nothing that was confessed to the form.
 */
---

<Base
  title="공유된 결과 | 헤어질 확률 계산기"
  description="공유된 관계 위험 지수 결과입니다."
  path="/r"
  noindex
>
  <div id="shared" class="mx-auto max-w-2xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p id="shared-state" class="gutter-label">불러오는 중…</p>

    <article id="shared-body" hidden>
      <p class="gutter-label"><span id="shared-kind"></span> · 공유된 결과</p>
      <div class="mt-6 flex items-end gap-5">
        <p class="font-serif text-[4.5rem] leading-none nums sm:text-[5.5rem]">
          <span id="shared-index">0</span><span class="text-[0.4em] align-super">%</span>
        </p>
        <p id="shared-badge" class="mb-3 border px-3 py-1 text-[0.8125rem] font-semibold tracking-wide">
        </p>
      </div>
      <p class="mt-4 text-[0.8125rem] text-ink-faint">관계 위험 지수</p>

      <h1 id="shared-headline" class="mt-7 text-[1.625rem] leading-snug sm:text-[1.875rem]"></h1>
      <p class="mt-6 border-l-2 border-clay pl-4 text-[0.875rem] leading-relaxed text-ink-soft">
        이 수치는 한 사람이 답한 결과이며, 정해진 미래가 아닙니다. 답변 내용은 저장되지 않아 이
        화면에도 표시되지 않습니다.
      </p>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="font-serif text-xl">네 가지 축으로 보면</h2>
        <dl id="shared-axes" class="mt-7 flex flex-col gap-5"></dl>
      </section>

      <section class="mt-14 border-t border-rule pt-8">
        <h2 class="font-serif text-xl">당신이 본 두 사람의 관계는 어떤가요?</h2>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
          같은 관계도 보는 자리에 따라 다르게 보입니다. 같은 질문에 직접 답해 보면, 어디에서 서로를
          다르게 느끼고 있었는지가 드러납니다.
        </p>
        <a
          id="shared-cta"
          href="/"
          class="mt-6 inline-block bg-ink px-5 py-3 text-[0.9375rem] font-semibold text-paper transition-opacity hover:opacity-88"
        >
          나도 해보기
        </a>
      </section>
    </article>

    <div id="shared-missing" hidden>
      <h1 class="mt-4 text-[1.75rem] leading-snug">결과를 찾을 수 없습니다</h1>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-soft">
        링크가 잘못되었거나 삭제된 결과일 수 있습니다. 직접 검사해 보시겠어요?
      </p>
      <a
        href="/"
        class="mt-8 inline-block bg-ink px-6 py-3.5 text-[0.9375rem] font-semibold text-paper transition-opacity hover:opacity-88"
      >
        계산기 둘러보기
      </a>
    </div>
  </div>
</Base>

<script>
  import { CONFIGS } from '../../lib/calc';
  import { GRADE_COPY } from '../../lib/calc/factors';
  import type { AxisResult, CalcType, Grade } from '../../lib/calc/types';
  import { fetchShared } from '../../lib/share';
  import { countUp, renderAxes, toneClasses } from '../../lib/result-view';

  const state = document.getElementById('shared-state')!;
  const missing = document.getElementById('shared-missing')!;

  function fail() {
    state.hidden = true;
    missing.hidden = false;
  }

  const slug = window.location.pathname.replace(/^\/r\/?/, '').replace(/\/$/, '');

  if (!slug) {
    fail();
  } else {
    fetchShared(slug)
      .then((row) => {
        if (!row) {
          fail();
          return;
        }

        const config = CONFIGS[row.calc_type as CalcType];
        const grade = GRADE_COPY[row.grade as Grade];
        if (!config || !grade) {
          fail();
          return;
        }

        state.hidden = true;
        document.getElementById('shared-body')!.hidden = false;
        document.getElementById('shared-kind')!.textContent = config.name;

        const badge = document.getElementById('shared-badge')!;
        badge.textContent = grade.name;
        badge.className = `mb-3 border px-3 py-1 text-[0.8125rem] font-semibold tracking-wide ${toneClasses(grade.tone)}`;
        document.getElementById('shared-headline')!.textContent = grade.headline;

        countUp(document.getElementById('shared-index')!, row.risk_index);

        // Rebuild the axis rows in the config's declared order so a stored
        // result always reads in the same sequence as a fresh one.
        const axes: AxisResult[] = config.axes.map((axis) => ({
          key: axis.key,
          label: axis.label,
          weight: axis.weight,
          value: Number(row.axis_scores?.[axis.key] ?? 0),
        }));
        renderAxes(document.getElementById('shared-axes')!, axes);

        const cta = document.getElementById('shared-cta') as HTMLAnchorElement;
        cta.href = config.path;
        cta.textContent = `${config.name} 해보기`;
      })
      .catch(fail);
  }
</script>
