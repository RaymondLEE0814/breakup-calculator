---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { twilight } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '황혼 이혼 계산기 | 은퇴 이후의 우리, 함께 갈 수 있을까';
const description =
  '결혼 20년, 30년. 은퇴와 자녀 독립 이후 달라진 두 사람의 하루를 15개 질문으로 점검합니다. 대화, 돌봄, 노후 자금까지 황혼 부부만의 항목으로 위험 신호를 정리해 드립니다.';

const faq = [
  {
    q: '황혼 이혼 계산기는 다른 계산기와 무엇이 다른가요?',
    a: '이 시기 부부에게만 해당하는 축이 하나 더 있습니다. 은퇴 후의 역할 조정, 한쪽에 몰린 돌봄 부담, 각자의 바깥 활동, 노후 자금 계획이 전체 지수의 45%를 차지합니다. 오래된 부부의 갈등은 대개 여기에서 시작되기 때문입니다.',
  },
  {
    q: '결혼한 지 20년이 안 됐는데 해도 되나요?',
    a: '가능합니다. 다만 은퇴와 자녀 독립을 전제로 만든 문항이 많아, 아직 그 시기가 아니라면 이혼 확률 계산기 쪽이 더 잘 맞습니다.',
  },
  {
    q: '졸혼을 생각하고 있어도 결과가 의미가 있나요?',
    a: '있습니다. 결과 화면은 지수만 보여주는 것이 아니라, 지수를 끌어올린 요인이 대화인지 돌봄인지 돈인지를 나눠서 보여줍니다. 무엇을 바꾸면 달라지는지 판단하는 데 쓰실 수 있습니다.',
  },
  {
    q: '돌봄 부담이 큰 상황입니다. 결과가 나쁘게 나오나요?',
    a: '한 사람에게 부담이 몰려 있다면 점수가 붙습니다. 애정이 부족해서가 아니라 체력의 문제이고, 방치하면 원망으로 바뀌기 때문입니다. 결과 화면에서는 분담 구조를 바꾸는 쪽을 제안합니다.',
  },
  {
    q: '배우자 몰래 해도 되나요?',
    a: '괜찮습니다. 답변은 기기 밖으로 나가지 않고, 계정도 기록도 남지 않습니다. 다만 두 분이 각자 답해 결과를 나란히 놓아 보시면, 서로를 어디에서 다르게 느끼고 있었는지가 드러납니다.',
  },
];

const reading = [
  {
    href: '/guide/twilight-divorce',
    title: '황혼이혼은 왜 늘어날까',
    blurb: '자녀 독립 이후의 부부에게 실제로 일어나는 일.',
  },
  {
    href: '/guide/four-horsemen',
    title: '이혼을 예측하는 4가지 대화 습관',
    blurb: '오래된 부부일수록 말투는 습관이 됩니다.',
  },
];

const schemas = [
  webAppLd({ name: twilight.name, path: '/twilight', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '황혼 이혼 계산기', path: '/twilight' },
  ]),
];
---

<Base title={title} description={description} path="/twilight" og="/og/twilight.png" schemas={schemas}>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={twilight} faq={faq} reading={reading} />
  </div>
</Base>
