---
import Base from '../../layouts/Base.astro';
import CalculatorScreen from '../../components/CalculatorScreen.astro';
import { twilight, twilightDeep } from '../../lib/calc';
import { breadcrumbLd, faqLd, webAppLd } from '../../lib/site';

const title = '황혼 이혼 계산기 | 1분 만에 보는 노년 부부 위험 신호';
const description =
  '일곱 개의 질문으로 오래 함께한 부부의 지금을 빠르게 확인합니다. 무엇이 이 결혼을 유지해 왔는지 — 마음인지 조건인지 — 를 묻는 문항이 핵심입니다. 무료, 회원가입 없음, 1분.';

const faq = [
  {
    q: '황혼 이혼 계산기는 다른 계산기와 무엇이 다른가요?',
    a: '핵심 문항이 다릅니다. "이 결혼을 유지해 온 이유"를 묻는 문항 하나가 이 검사에서 가장 많은 정보를 줍니다. 30년을 함께 살았다는 것은 지속의 기록이지 안정의 증거가 아니고, 마음이 아니라 조건이 지탱해 온 관계는 그 조건이 사라질 때 함께 흔들리기 때문입니다.',
  },
  {
    q: '결혼한 지 20년이 안 됐는데 해도 되나요?',
    a: '가능하지만, 은퇴와 자녀 독립을 전제로 만든 문항이 많습니다. 아직 그 시기가 아니라면 이혼 확률 계산기 쪽이 더 잘 맞습니다.',
  },
  {
    q: '졸혼을 생각하고 있어도 의미가 있나요?',
    a: '있습니다. 이 검사는 결론을 권하지 않고, 지금 어디에 무게가 실려 있는지를 보여줍니다. 심화 진단에서는 헌신과 제약을 따로 재서 네 가지 유형 중 어디에 해당하는지까지 알려드립니다.',
  },
  {
    q: '배우자 몰래 해도 되나요?',
    a: '괜찮습니다. 답변은 기기 밖으로 나가지 않고, 계정도 기록도 남지 않습니다. 다만 두 분이 각자 답해 결과를 나란히 놓아 보시면, 서로를 어디에서 다르게 느끼고 있었는지가 드러납니다.',
  },
];

const reading = [
  {
    href: '/guide/twilight-divorce',
    title: '황혼이혼은 왜 늘어날까',
    blurb: '자녀 독립 이후의 부부에게 실제로 일어나는 일.',
  },
  {
    href: '/guide/four-horsemen',
    title: '이혼을 예측하는 4가지 대화 습관',
    blurb: '오래된 부부일수록 말투는 습관이 됩니다.',
  },
];

const schemas = [
  webAppLd({ name: twilight.name, path: '/twilight', description }),
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '황혼 이혼 계산기', path: '/twilight' },
  ]),
];
---

<Base
  title={title}
  description={description}
  path="/twilight"
  og="/og/twilight.png"
  schemas={schemas}
>
  <div class="pt-12 pb-8 sm:pt-16">
    <CalculatorScreen config={twilight} faq={faq} reading={reading} sibling={twilightDeep} />
  </div>
</Base>
