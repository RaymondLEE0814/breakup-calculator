---
import Base from '../../layouts/Base.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import { breadcrumbLd, faqLd } from '../../lib/site';

const title = '이혼 법률 상담 신청 | 이혼 확률 계산기';
const description =
  '이혼 절차나 조건을 알아보기 시작하셨다면. 호칭과 연락처만 남기시면 연락드립니다. 이 신청은 법률 자문 계약이 아니며, 신청만으로 비용이 발생하지 않습니다.';

const faq = [
  {
    q: '신청하면 이혼을 진행해야 하나요?',
    a: '아닙니다. 상담은 선택지를 알아보는 자리이고, 알아본 뒤 아무것도 하지 않으셔도 됩니다. 실제로 절차를 알아본 뒤 관계를 다시 잡는 경우도 적지 않습니다.',
  },
  {
    q: '비용이 드나요?',
    a: '이 신청은 법률 자문 계약이 아니며, 신청만으로 비용이 발생하지 않습니다. 상담 비용과 진행 여부는 담당자와 이야기하신 뒤 결정하시면 됩니다.',
  },
  {
    q: '과실 비율 계산기 결과가 전달되나요?',
    a: '체크하셨을 때만, 그것도 비율 구간과 주요 사유 범주까지만 전달됩니다. 문항에 어떻게 답하셨는지는 전달되지 않습니다.',
  },
  {
    q: '무엇을 준비해 가면 좋나요?',
    a: '혼인 기간, 다투게 된 경위, 재산과 자녀 관련 사정을 시간 순으로 정리해 두시면 첫 상담이 훨씬 빨라집니다. 과실 비율 계산기를 먼저 해 보시는 것도 정리에 도움이 됩니다.',
  },
];

const schemas = [
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '법률 상담 신청', path: '/legal' },
  ]),
];
---

<Base title={title} description={description} path="/legal" schemas={schemas}>
  <section class="mx-auto max-w-3xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p class="gutter-label">법률 상담</p>
    <h1 class="mt-4 text-[2rem] leading-tight sm:text-[2.5rem]">이혼 법률 상담 신청</h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-soft">
      절차나 조건을 이미 알아보기 시작하셨다면, 감정이 아니라 정보로 준비하는 편이 낫습니다. 호칭과
      연락처만 남겨 주시면 연락을 드립니다.
    </p>
    <p class="mt-4 rounded-xl border border-rule p-4 text-[0.875rem] leading-relaxed text-ink-soft">
      이 신청은 법률 자문 계약이 아니며, 신청만으로 비용이 발생하지 않습니다. 이 페이지의 어떤 내용도
      구체적 사안에 대한 법률 자문이 아닙니다.
    </p>

    <ConsultForm kind="legal" />

    <section class="mt-16 border-t border-rule pt-10">
      <h2 class="text-[1.75rem]">자주 묻는 질문</h2>
      <dl class="mt-6">
        {
          faq.map((item) => (
            <div class="border-t border-rule-soft py-5 first:border-t-0 first:pt-0">
              <dt class="text-[0.9375rem] font-semibold">{item.q}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </section>
</Base>
