---
import Base from '../layouts/Base.astro';
---

<Base
  title="찾을 수 없는 페이지 | 이혼 확률 계산기"
  description="요청하신 페이지를 찾을 수 없습니다."
  path="/404"
  noindex
>
  <section class="mx-auto max-w-3xl px-5 pt-20 pb-16 sm:px-8 sm:pt-28">
    <p class="gutter-label nums">404</p>
    <h1 class="mt-4 text-[2rem] leading-tight">찾을 수 없는 페이지입니다</h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-soft">
      주소가 바뀌었거나, 없는 주소일 수 있습니다. 아래에서 원하시는 곳으로 이동하실 수 있습니다.
    </p>
    <div class="mt-10 grid gap-3 sm:grid-cols-2">
      {
        [
          { href: '/breakup', label: '연애 헤어질 확률 계산기', sub: '연애 · 16문항' },
          { href: '/divorce', label: '이혼 확률 계산기', sub: '부부 · 18문항' },
          { href: '/twilight', label: '황혼 이혼 계산기', sub: '황혼 · 15문항' },
          { href: '/guide', label: '관계 가이드', sub: '문항의 근거가 된 글들' },
        ].map((item) => (
          <a href={item.href} class="group flex min-h-28 flex-col justify-between rounded-2xl border border-rule-soft bg-paper-raised p-5 transition-[transform,border-color,background-color] hover:-translate-y-0.5 hover:border-clay hover:bg-white">
            <span class="text-[1rem] font-semibold transition-colors group-hover:text-clay">{item.label}</span>
            <span class="text-[0.8125rem] text-ink-faint">{item.sub}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
