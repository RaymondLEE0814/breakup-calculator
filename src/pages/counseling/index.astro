---
import Base from '../../layouts/Base.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import { breadcrumbLd, faqLd } from '../../lib/site';

const title = '부부상담 신청 | 이혼 확률 계산기';
const description =
  '검사 결과를 들고 부부상담을 받아 보고 싶으실 때. 호칭과 연락처만 남기시면 상담 기관에서 연락드립니다. 신청만으로 비용이 발생하지 않습니다.';

const faq = [
  {
    q: '결과가 나쁘지 않은데 상담을 받아도 되나요?',
    a: '오히려 그때가 좋은 시점입니다. 상담은 문제가 커진 뒤의 수리라기보다, 패턴이 굳기 전의 조정에 가깝습니다. 굳은 뒤에는 같은 변화를 만드는 데 훨씬 오래 걸립니다.',
  },
  {
    q: '배우자와 함께 가야 하나요?',
    a: '함께 가는 편이 효과가 크지만, 혼자 시작하는 상담도 의미가 있습니다. 신청서의 남기고 싶은 말에 상황을 적어 주시면 그에 맞게 안내받으실 수 있습니다.',
  },
  {
    q: '검사 결과가 함께 전달되나요?',
    a: '체크하셨을 때만 전달됩니다. 그 경우에도 지수와 등급, 유형까지이며 문항에 어떻게 답하셨는지는 전달되지 않습니다.',
  },
  {
    q: '신청하면 바로 비용이 드나요?',
    a: '아니요. 신청은 연결을 요청하는 것이고, 상담 진행 여부와 비용은 기관과 이야기하신 뒤 결정하시면 됩니다. 연락을 받고 사양하셔도 됩니다.',
  },
];

const schemas = [
  faqLd(faq),
  breadcrumbLd([
    { name: '홈', path: '/' },
    { name: '부부상담 신청', path: '/counseling' },
  ]),
];
---

<Base title={title} description={description} path="/counseling" schemas={schemas}>
  <section class="mx-auto max-w-3xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p class="gutter-label">부부상담</p>
    <h1 class="mt-4 text-[2rem] leading-tight sm:text-[2.5rem]">부부상담 신청</h1>
    <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-soft">
      혼자 애쓰는 것보다 제3자의 눈이 빠른 때가 있습니다. 호칭과 연락처만 남겨 주시면 상담 기관에서
      연락을 드립니다. 신청만으로 비용이 발생하지 않고, 연락을 받고 사양하셔도 됩니다.
    </p>

    <ConsultForm kind="counseling" />

    <section class="mt-16 border-t border-rule pt-10">
      <h2 class="text-[1.75rem]">자주 묻는 질문</h2>
      <dl class="mt-6">
        {
          faq.map((item) => (
            <div class="border-t border-rule-soft py-5 first:border-t-0 first:pt-0">
              <dt class="text-[0.9375rem] font-semibold">{item.q}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </section>
</Base>
